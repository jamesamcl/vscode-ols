Prefix(:=<http://purl.obolibrary.org/obo/ex.owl#>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(oboInOwl:=<http://www.geneontology.org/formats/oboInOwl#>)


Ontology(<http://purl.obolibrary.org/obo/ex.owl>

# EX terms are labelled below, so their labels show inline without OLS.
# obo:BFO_0000051 (has part) is only labelled inline with ols.inlayHints.lookUpInOls on.

Declaration(Class(obo:EX_0000001))
Declaration(Class(obo:EX_0000002))
Declaration(Class(obo:EX_0000003))
Declaration(ObjectProperty(obo:BFO_0000051))

AnnotationAssertion(rdfs:label obo:EX_0000001 "device"@en)
AnnotationAssertion(obo:IAO_0000115 obo:EX_0000002 "A small part that is assembled into devices."@en)
AnnotationAssertion(rdfs:label obo:EX_0000002 "widget"@en)
AnnotationAssertion(obo:IAO_0000115 obo:EX_0000003 "A device made of widgets."@en)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "ORCID:0000-0000-0000-0000") rdfs:label obo:EX_0000003 "widget assembly"@en)

SubClassOf(obo:EX_0000002 obo:EX_0000001)
SubClassOf(obo:EX_0000003 obo:EX_0000001)
SubClassOf(obo:EX_0000003 ObjectSomeValuesFrom(obo:BFO_0000051 obo:EX_0000002))
)
